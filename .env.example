# ============================================================================
# PROJETO: O Orçamento na Hora (SENAI-SP)
# MODELO DE VARIÁVEIS DE AMBIENTE (.env.example)
# ============================================================================

# ----------------------------------------------------------------------------
# 1. SUPABASE (BANCO DE DADOS & EDGE FUNCTIONS)
# ----------------------------------------------------------------------------
# URL do projeto no Supabase (ex: https://xyzcompany.supabase.co ou http://127.0.0.1:54321)
SUPABASE_URL="https://seu-projeto-id.supabase.co"

# Chave anônima pública (anon key)
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Chave mestra de serviço (service_role key) - Usada nas Edge Functions para escrita segura
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ----------------------------------------------------------------------------
# 2. GROQ CLOUD API (INTELIGÊNCIA ARTIFICIAL)
# ----------------------------------------------------------------------------
# Obtenha sua chave gratuita em: https://console.groq.com/keys
GROQ_API_KEY="gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Modelo da família Qwen com suporte a Tool Calling e Raciocínio
# Opções recomendadas: "qwen-2.5-32b", "deepseek-r1-distill-qwen-32b", "qwen-2.5-coder-32b"
GROQ_MODEL="qwen-2.5-32b"

# ----------------------------------------------------------------------------
# 3. TELEGRAM BOT API (NOTIFICAÇÃO EM TEMPO REAL)
# ----------------------------------------------------------------------------
# Token do bot gerado pelo @BotFather no Telegram (ex: 123456789:ABCdefGhIJKlmNoPQRstuVWXyz)
TELEGRAM_BOT_TOKEN="1234567890:ABC-DEF1234ghIkl-zyx57W2v1u123ew11"

# Chat ID do Telegram do pintor ou do grupo onde as notificações chegarão
# Obtenha enviando uma mensagem para @userinfobot ou via https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID="123456789"
